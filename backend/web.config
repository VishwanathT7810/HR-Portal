<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\Users\BT\Desktop\new\Employee Information\backend\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --port %HTTP_PLATFORM_PORT% --workers 2"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\backend.log"
                  startupTimeLimit="60">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
